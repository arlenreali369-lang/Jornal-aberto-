{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Public news post created by authors with title, subtitle, cover image, and body",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 50 },
        "coverImage": { "type": "string", "maxLength": 800000 },
        "coverCaption": { "type": "string", "maxLength": 300 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array" },
        "likes": { "type": "number" },
        "views": { "type": "number" },
        "featured": { "type": "boolean" },
        "breakingNews": { "type": "boolean" },
        "readTimeMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "category", "coverImage", "authorId", "authorName", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Public comment on a news article",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "Record of user liking a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public news articles readable by everyone and creatable by authenticated or verified users"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Public comments for a news post readable by all and creatable by authenticated users"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Record of user liking a post"
    }
  }
}
